# Copie para .env e preencha os valores reais.
DEBUG=True
SECRET_KEY=django-insecure-troque-esta-chave
ALLOWED_HOSTS=localhost,127.0.0.1

SUPABASE_URL=
SUPABASE_KEY=

# Banco PostgreSQL (ex.: Render). Sem esta variável, usa SQLite local.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# DB_CONN_MAX_AGE=600

# Opcionais (produção)
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=senha-forte
# DJANGO_SUPERUSER_EMAIL=admin@exemplo.com
# SEED_DEMO=1
